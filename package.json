{
  "name": "tmap",
  "private": true,
  "version": "0.1.0",
  "description": "ToiletKort (TMap) – et åbent kort over offentlige toiletter i Danmark",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev dist --d1 DB=tmap",
    "db:migrate:local": "wrangler d1 migrations apply tmap --local",
    "db:migrate:remote": "wrangler d1 migrations apply tmap --remote",
    "import:local": "node scripts/import-osm.mjs --local",
    "import:remote": "node scripts/import-osm.mjs --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name tmap --branch main",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "opening_hours": "^3.16.0"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  }
}
